# Build stage
# 构建阶段固定在构建机原生架构上运行（不经 QEMU 模拟）：
# next build 的 standalone 产物是纯 JS，不含原生模块，可直接用于各目标架构
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app

# Install pnpm via corepack (no global npm install / npm cache)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies with cache optimization
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build application (next.config.js uses output: 'standalone')
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build && mkdir -p /app/data/images

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# 运行阶段不包含 RUN 指令，跨架构构建时无需在 QEMU 中执行任何命令；
# 使用官方镜像自带的非 root 用户 node
# Copy only the standalone server output, static assets and public files
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
# 粘贴上传的图片目录（通常挂载为数据卷）
COPY --from=builder --chown=node:node /app/data ./data

# Switch to non-root user
USER node

# Expose port
EXPOSE 3000

# Start the application
CMD ["node", "server.js"]
